{
  "description": "cc-kfuzz hooks: report cc-fuzzer drift against UPSTREAM.lock at session start; refuse writes into kfuzz/verified/ except through kfuzz-findings.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/kfuzz-compat --quiet || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/gate-verified.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
